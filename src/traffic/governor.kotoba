(ns traffic.governor
  "TrafficGovernor -- the independent safety/traceability layer for the
  ISCO-08 2164 town and traffic planning actor. Wired as its own `:govern`
  node in `traffic.actor`'s StateGraph, downstream of `:advise` -- the Advisor
  has no notion of site provenance, planning authority, or the planner's
  professional/legal responsibility, so this MUST be a separate system able to
  reject a proposal (itonami actor pattern, per ADR-2607011000 / CLAUDE.md
  Actors section).

  `check` is a pure function of (request, context, proposal, store) -> verdict;
  it never mutates the store. `traffic.phase/of-verdict` routes on it.

  ## What this namespace decides, and what it delegates

  It used to decide everything inline, and three of those decisions were
  measurably wrong on a77acee. Each is now delegated to a namespace that can
  be tested without building a graph:

    vocabulary    -> traffic.operation  (was: a three-branch `or` naming
                                        forbidden ops, i.e. a denylist that
                                        admitted every op it had not been
                                        told about)
    well-formedness -> traffic.facts    (was: `(nil? site-record)`, which a
                                        blank registration defeated, and no
                                        envelope check at all, so a string
                                        `:confidence` threw out of `check`)
    routing       -> traffic.phase      (was: an inline `cond` in the graph)

  ## HARD invariants (`:hard? true`, ALWAYS `:hold`, never overridable)

    1. site provenance     -- the request must name a site, and that site must
       be registered under a record that identifies itself.
    2. no-actuation        -- proposal `:effect` must be `:propose`.
    3. no-binding-authority -- binding zoning changes, traffic regulations and
       development approvals are the planning authority's exclusive
       responsibility (`traffic.operation/reserved`).
    4. declared vocabulary -- an op outside `traffic.operation/supported` is
       refused as undeclared. This is the allowlist: it is what makes the
       three rules above a boundary rather than three examples.
    5. well-formed envelope -- a proposal whose `:op` is not a keyword or
       whose `:confidence` is present but not a number in [0,1] is refused
       rather than compared against.

  ## ESCALATION invariants (`:escalate? true`, ALWAYS human sign-off)

    6. operations declared `:escalates?` (e.g. `:flag-public-safety-concern`).
    7. proposals touching safety-critical systems (pedestrian crossings,
       emergency routes, signalled intersections).
    8. confidence below `confidence-floor`."
  (:require [traffic.facts :as facts]
            [traffic.operation :as op]
            [traffic.store :as store]))

(def confidence-floor 0.6)

(def ^:private safety-critical-keywords
  #{:pedestrian-safety :emergency-route :intersection :traffic-signal :crossing})

(defn- hard-violations
  "Every hard rule, in one vector. Ordering is presentational only -- any
  non-empty result holds."
  [request proposal site-record]
  (into []
        (concat
         (facts/request-violations request)
         (facts/proposal-violations proposal)
         (facts/vocabulary-violations proposal)
         ;; Provenance is asked of the record, not of the store's return
         ;; value. A request that names no site has already been reported by
         ;; request-violations; reporting :no-site as well would say the same
         ;; thing twice, so it is only asked when a site was actually named.
         (when-not (seq (facts/request-violations request))
           (if (nil? site-record)
             [{:rule :no-site :detail "未登録 site"}]
             (facts/site-record-violations site-record)))
         (when (not= :propose (:effect proposal))
           [{:rule :no-actuation
             :detail "effect は :propose のみ許可（直接書込禁止）"}]))))

(defn- safety-critical-system? [{:keys [scope tags]}]
  (and scope tags (some safety-critical-keywords tags)))

(defn- usable-confidence
  "The confidence to compare against the floor. Only reached once
  `facts/proposal-violations` has admitted the envelope, so a non-number here
  is impossible rather than merely unlikely -- but an absent confidence is
  legitimate and reads as 0.0, which escalates."
  [proposal]
  (let [c (:confidence proposal)]
    (if (number? c) c 0.0)))

(defn check
  "Assess a proposal against `request`/`context`/`proposal` and a `store`
  implementing `traffic.store/Store`. Returns
  `{:ok? bool :violations [...] :confidence n :hard? bool :escalate? bool}`."
  ;; `context` is part of the node's signature and is deliberately unused:
  ;; this governor's rules are all functions of the request, the proposal and
  ;; the registered site. It is named with a leading underscore so that stays
  ;; a statement rather than an oversight.
  [request _context proposal store]
  (let [site-record (store/site store (:site-id request))
        hard (hard-violations request proposal site-record)
        hard? (boolean (seq hard))
        conf (usable-confidence proposal)
        low? (< conf confidence-floor)
        escalating-op? (op/escalates? (:op proposal))
        safety-critical? (and (not hard?) (safety-critical-system? proposal))]
    {:ok? (and (not hard?) (not low?) (not escalating-op?) (not safety-critical?))
     :violations hard
     :confidence conf
     :hard? hard?
     :escalate? (and (not hard?) (or low? escalating-op? safety-critical?))}))
