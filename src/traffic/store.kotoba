(ns traffic.store
  "SSoT for the ISCO-08 2164 town and traffic planning
  practice actor. Store is a protocol injected into the `traffic.actor`
  StateGraph — `MemStore` is the default, deterministic, zero-dep
  backend; a Datomic/kotoba-server-backed implementation can be
  swapped in without touching the actor or governor (itonami actor
  pattern, per ADR-2607011000 / CLAUDE.md Actors section).

  Domain:

    site     — a registered planning site (site-id, location, jurisdiction)
    record   — a committed planning record under a site
               (zoning scenario draft, traffic analysis, traffic safety
               concern, public consultation session) — written ONLY via
               commit-record!, never mutated in place
    ledger   — an append-only audit trail of every proposal/verdict/
               disposition, regardless of outcome (commit or hold)

  The ledger is chained: `append-ledger!` routes every entry through
  `traffic.ledger/append`, which stamps `:ledger/seq`, `:ledger/prev` and
  `:ledger/hash`. That is what makes 'append-only' a property of the artifact
  rather than of the code path that produced it — see `traffic.ledger`. The
  protocol signature is unchanged; callers still pass a plain map."
  ;; alias is `led`, not `ledger`: this namespace also defines a protocol
  ;; method named `ledger`, and shadowing the two names in one file is
  ;; needless work for the next reader.
  (:require [traffic.ledger :as led]))

(defprotocol Store
  (site [s site-id])
  (records-of [s site-id])
  (ledger [s])
  (register-site! [s site])
  (commit-record! [s record])
  (append-ledger! [s fact]))

(defrecord MemStore [a]
  Store
  (site [_ site-id] (get-in @a [:sites site-id]))
  (records-of [_ site-id] (filter #(= site-id (:site-id %)) (:records @a)))
  (ledger [_] (:ledger @a))
  (register-site! [s site]
    (swap! a assoc-in [:sites (:site-id site)] site) s)
  (commit-record! [s record]
    (swap! a update :records (fnil conj []) record) s)
  (append-ledger! [s fact]
    (swap! a update :ledger (fnil led/append []) fact) s))

(defn mem-store
  ([] (mem-store {}))
  ([seed] (->MemStore (atom (merge {:sites {} :records [] :ledger []} seed)))))
